// Default tab layout + a two-row agent strip under the native tab bar.
// Use: zellij --layout /home/ondra/dev/zellij-agents-manager/layouts/agents.kdl   (or set default_layout)
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane size=2 borderless=true {
            plugin location="file:/home/ondra/dev/zellij-agents-manager/dist/zellij-agents.wasm" {
                mode "bar"
                scanner "/home/ondra/dev/zellij-agents-manager/scripts/zam-scan.py"
            }
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab
}
